# ==============================================================================
# Pipeline SCADA Leak Detection Environment Configuration Template
# Duplicate this file to .env and configure local/production variables.
# NEVER commit real secret credentials or production API keys to source control.
# ==============================================================================

# Streamlit Server Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Model & SCADA Telemetry Configuration
DEFAULT_ALARM_THRESHOLD=0.30
HISTORY_BUFFER_SIZE=60
AUTO_REFRESH_INTERVAL_SEC=3

# Optional Telephony / SCADA Industrial Ingestion (Future Extension)
OPC_UA_SERVER_ENDPOINT=opc.tcp://localhost:4840/scada/pipeline/telemetry
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=scada/pipeline/sensors

# Optional Notification Alerts (e.g., Slack / PagerDuty / Webhook)
ALERT_WEBHOOK_URL=https://hooks.example.com/services/pipeline-alerts
ALERT_EMAIL_RECIPIENT=operations@pipeline-scada.internal
